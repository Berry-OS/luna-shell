#!/usr/bin/env python3
"""Save what the Luna compositor is showing as a PNG.

    luna-screenshot [PATH]            # default: ~/Screenshots/luna-<time>.png
    LUNA_SOCKET_DIR=... luna-screenshot out.png

Also logs a `[luna-dump]` line per window (geometry, buffer, decoration)
to the compositor's log.  Works on every backend (DRI/GPU included) and also while the session's VT is
not the active one.  Needs a compositor built with `screenshot_out` support;
the compositor writes the file, so PATH must be writable by that process.
"""
import os, socket, sys, time

runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
sock_dir = os.path.join(runtime, "luna-shell")
path = os.path.abspath(sys.argv[1]) if len(sys.argv) > 1 else os.path.join(
    os.path.expanduser("~/Screenshots"), time.strftime("luna-%Y-%m-%d_%H-%M-%S.png"))
os.makedirs(os.path.dirname(path), exist_ok=True)
if os.path.exists(path):
    os.unlink(path)
s = socket.socket(socket.AF_UNIX)
try:
    os.chdir(sock_dir)                      # keeps the sun_path short
    s.connect("luna-shell.sock")
except OSError as e:
    sys.exit(f"luna-screenshot: cannot reach the compositor in {sock_dir}: {e}")
s.send(f"dump_windows\nscreenshot_out {path}\n".encode())
s.close()
for _ in range(100):                        # up to ~5 s
    if os.path.exists(path):
        print(path)
        sys.exit(0)
    time.sleep(0.05)
sys.exit("luna-screenshot: no file written (compositor too old or not running?)")
