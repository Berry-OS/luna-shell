/* Hallmark · theme: Windows 95 · chrome: taskbar · enrichment: Tier A CSS
 * audience: retro desktop users · use: live desktop skin switching
 */
:root {
  --w95-teal: #008080;
  --w95-teal-lo: #004040;
  --w95-grey: #c0c0c0;
  --w95-grey-hi: #dfdfdf;
  --w95-grey-lo: #808080;
  --w95-navy: #000080;
  --w95-ink: #000000;
  --w95-white: #ffffff;
  --w95-shadow: #00000088;
  --w95-clear: #00000000;
  --color-accent: var(--w95-navy);
  --color-accent-ink: var(--w95-white);
  --color-paper: var(--w95-grey);
  --color-ink: var(--w95-ink);
  --color-muted: #404040;
  --color-focus: var(--w95-navy);
  --luna-accent: var(--w95-navy);
  --luna-accent-2: #0000a8;
  --luna-accent-dark: #000060;
  --luna-gold: #808000;
  --luna-glass: var(--w95-grey);
  --luna-glass-card: var(--w95-grey-hi);
  --luna-glass-edge: var(--w95-grey-lo);
  --luna-text: var(--w95-ink);
  --luna-text-dim: #404040;
  --luna-text-muted: #404040;
  --dialog-surface: var(--w95-grey);
  --dialog-footer: var(--w95-grey);
  --dialog-divider: var(--w95-grey-lo);
  --about-surface: var(--w95-grey);
  --about-card: var(--w95-grey-hi);
  --about-card-hover: var(--w95-white);
  --about-icon: var(--w95-navy);
  --about-border: var(--w95-grey-lo);
  --radius-xl: 0;
  --radius-lg: 0;
  --radius-md: 0;
  --radius-sm: 0;
}

html, body { background: var(--w95-teal); color: var(--w95-ink); }
#wallpaper,
#wallpaper.ocean,
#wallpaper.forest,
#wallpaper.sunset {
  background: var(--w95-teal);
}
#wp_aurora1, #wp_aurora2, #wp_moon, #wp_moon_halo, .star { display: none; }

#menubar,
#menubar.edge_bottom {
  top: auto; bottom: 0; height: 28px; padding: 0 2px;
  background: var(--w95-grey);
  border: 0; border-top: 2px solid var(--w95-white);
  border-radius: 0; box-shadow: inset 0 1px var(--w95-grey-hi);
}
#mb_left, #mb_center, #mb_right { height: 28px; }
#mb_logo {
  width: auto; min-width: 54px; height: 22px; padding: 0 8px;
  border-radius: 0;
  background: var(--w95-grey);
  border-top: 2px solid var(--w95-white);
  border-left: 2px solid var(--w95-white);
  border-right: 2px solid #000000;
  border-bottom: 2px solid #000000;
  box-shadow: inset -1px -1px var(--w95-grey-lo), inset 1px 1px var(--w95-grey-hi);
}
#mb_logo_glyph, #mb_app, .mb_app_name, .mb_item, .mb_status, .tray_glyph, .win_label { color: var(--w95-ink); }
.mb_item { border-radius: 0; height: 22px; }
.mb_item:hover, .tray_item:hover { background-color: transparent; color: var(--w95-ink); }
.win_item {
  height: 22px; border-radius: 0; padding: 0 8px;
  background: var(--w95-grey);
  border-top: 2px solid var(--w95-white);
  border-left: 2px solid var(--w95-white);
  border-right: 2px solid #000000;
  border-bottom: 2px solid #000000;
}
.win_item.active {
  background: var(--w95-grey-hi);
  border-top: 2px solid #000000;
  border-left: 2px solid #000000;
  border-right: 2px solid var(--w95-white);
  border-bottom: 2px solid var(--w95-white);
}

.menu_panel {
  top: auto; bottom: 30px;
  background: var(--w95-grey); color: var(--w95-ink);
  border-top: 2px solid var(--w95-white);
  border-left: 2px solid var(--w95-white);
  border-right: 2px solid #000000;
  border-bottom: 2px solid #000000;
  border-radius: 0; box-shadow: 2px 2px 0 var(--w95-shadow); animation: none;
}
.menu_item { border-radius: 0; }
.menu_item:hover { background: var(--w95-navy); box-shadow: none; }
.menu_item:hover .mi_label, .menu_item:hover .mi_sym, .menu_item:hover .mi_key { color: var(--w95-white); }
.menu_section_label, .mi_label, .mi_sym, .mi_key { color: var(--w95-ink); }
.menu_sep { background-color: var(--w95-grey-lo); }

#dock, #dock.hidden { display: none !important; }

.widget, #toast, #switcher_strip {
  background: var(--w95-grey); color: var(--w95-ink);
  border-top: 2px solid var(--w95-white);
  border-left: 2px solid var(--w95-white);
  border-right: 2px solid #000000;
  border-bottom: 2px solid #000000;
  border-radius: 0; box-shadow: 2px 2px 0 var(--w95-shadow);
}
#wg_time, #wg_date, #wg_cpu, #wg_mem, #wg_disk, #toast_title, #toast_msg, .sw_title, .sw_app { color: var(--w95-ink); }

.sheet_box, #settings_sheet.sheet_box, #about_box.about_box, #confirm_box.dialog_alert {
  background: var(--w95-grey); color: var(--w95-ink);
  border-top: 2px solid var(--w95-white);
  border-left: 2px solid var(--w95-white);
  border-right: 2px solid #000000;
  border-bottom: 2px solid #000000;
  border-radius: 0; box-shadow: 3px 3px 0 var(--w95-shadow);
}
#settings_title {
  background: var(--w95-navy); color: var(--w95-white);
  text-align: left; padding-left: 88px; border-bottom: 1px solid #000000;
}
#settings_sidebar, #settings_btns, #confirm_btns { background: var(--w95-grey); }
.panel_heading { color: var(--w95-navy); }
.stab, .pref_label, .pref_hint, .pref_section, .wm_pref_name, .wm_pref_desc,
.skin_name, .skin_desc, .cur_name, .cur_desc, .kb_name, .kb_desc { color: var(--w95-ink); }
.stab:hover, .skin_card:hover, .cur_card:hover, .kb_card:hover, .wm_pref:hover { background-color: var(--w95-grey-hi); color: var(--w95-ink); }
.stab.active, .skin_card.selected, .cur_card.selected, .kb_card.selected, .wm_choice.selected {
  background: var(--w95-navy); color: var(--w95-white); border-color: #000000; box-shadow: none;
}
.stab.active .stab_icon, .skin_card.selected .skin_name, .skin_card.selected .skin_desc { color: var(--w95-white); }
.pref_input, .pref_input_full, #wifi_password {
  background: var(--w95-white); color: var(--w95-ink); border-color: var(--w95-grey-lo); border-radius: 0;
}
.dlg_btn {
  background: var(--w95-grey); color: var(--w95-ink);
  border-top: 2px solid var(--w95-white); border-left: 2px solid var(--w95-white);
  border-right: 2px solid #000000; border-bottom: 2px solid #000000;
  border-radius: 0; box-shadow: none;
}
.dlg_btn.primary { background: var(--w95-grey-hi); }
.dlg_btn:hover { background: var(--w95-grey-hi); color: var(--w95-ink); }
.dlg_btn.primary:hover { background: var(--w95-white); color: var(--w95-ink); }
.dlg_btn:focus-visible, .skin_card:focus-visible { outline: 1px dotted #000000; outline-offset: 2px; }

@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 1ms; transition-duration: 1ms; }
}
