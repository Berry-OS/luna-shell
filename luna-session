#!/usr/bin/env bash
# Luna Desktop session launcher — fast/system-Wayland edition.
# No libdecor setup, no vendored libwayland preload, no runtime polling loop.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="${PROFILE:-release}"
TARGET="$ROOT/target/$PROFILE"
BACKEND="${BACKEND:-dri}"
SOCKET="${LUNA_SOCKET:-wayland-0}"
SIZE="${LUNA_SIZE:-}"
FBDEV="${LUNA_FBDEV:-}"
PORT="${LUNA_WEBGL_PORT:-8081}"

COMPOSITOR_PID=""
SHELL_PID=""
INPUT_METHOD_PID=""
CLIPBOARD_PID=""
APP_PIDS=()
CLEANING=0

die() { printf 'luna-session: %s\n' "$*" >&2; exit 1; }

is_running() {
    [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

cleanup() {
    [ "$CLEANING" = 0 ] || return
    CLEANING=1
    trap - EXIT INT TERM HUP

    local pids=()
    local p
    for p in "${APP_PIDS[@]}"; do [ -n "$p" ] && pids+=("$p"); done
    [ -n "$INPUT_METHOD_PID" ] && pids+=("$INPUT_METHOD_PID")
    [ -n "$CLIPBOARD_PID" ] && pids+=("$CLIPBOARD_PID")
    [ -n "$SHELL_PID" ] && pids+=("$SHELL_PID")
    [ -n "$COMPOSITOR_PID" ] && pids+=("$COMPOSITOR_PID")

    for p in "${pids[@]}"; do kill -TERM "$p" 2>/dev/null || true; done
    for _ in {1..20}; do
        local alive=0
        for p in "${pids[@]}"; do is_running "$p" && alive=1; done
        [ "$alive" = 1 ] || break
        sleep 0.05
    done
    for p in "${pids[@]}"; do
        is_running "$p" && kill -KILL "$p" 2>/dev/null || true
    done
    for p in "${pids[@]}"; do wait "$p" 2>/dev/null || true; done
    rm -f "${XDG_RUNTIME_DIR:-/tmp}/$SOCKET" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

# XDG runtime directory
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    if [ ! -d "$XDG_RUNTIME_DIR" ]; then
        XDG_RUNTIME_DIR="/tmp/luna-runtime-$(id -u)"
    fi
fi
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
export XDG_RUNTIME_DIR

# Prefer source-tree target when this script lives in the repository.
# This avoids accidentally running a stale luna-compositor copied beside the script.
if [ -n "${LUNA_BIN:-}" ]; then
    BIN="$LUNA_BIN"
elif [ -f "$ROOT/wayland-server-rs/Cargo.toml" ]; then
    BIN="$TARGET"
else
    BIN="$ROOT"
fi

if [ ! -x "$BIN/luna-compositor" ] || [ ! -x "$BIN/luna-shell" ]; then
    if [ -f "$ROOT/Makefile" ]; then
        echo "→ Building Luna desktop (system Wayland)"
        make -C "$ROOT" build-desktop-system PROFILE="$PROFILE"
        BIN="$TARGET"
    else
        command -v luna-compositor >/dev/null 2>&1 || die "luna-compositor not found"
        command -v luna-shell >/dev/null 2>&1 || die "luna-shell not found"
        BIN="$(dirname "$(command -v luna-compositor)")"
    fi
fi

COMPOSITOR="${LUNA_COMPOSITOR:-$BIN/luna-compositor}"
SHELL_BIN="${LUNA_SHELL:-$BIN/luna-shell}"
[ -x "$COMPOSITOR" ] || die "not executable: $COMPOSITOR"
[ -x "$SHELL_BIN" ] || die "not executable: $SHELL_BIN"

# Session preferences: only values needed before compositor startup.
SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/luna-shell/settings.conf"
saved_lang=""
saved_layout=""
saved_numlock=""
if [ -r "$SETTINGS" ]; then
    while IFS='=' read -r k v; do
        case "$k" in
            ui_language) saved_lang="$v" ;;
            kb_layout)   saved_layout="$v" ;;
            numlock_on)  saved_numlock="$v" ;;
        esac
    done < "$SETTINGS"
fi

case "$saved_lang" in
    ja_JP.UTF-8|en_US.UTF-8|C.UTF-8) export LANG="$saved_lang" LC_ALL="$saved_lang" ;;
    *) export LANG="${LANG:-ja_JP.UTF-8}" ;;
esac

if [ -z "${XKB_DEFAULT_LAYOUT:-}" ]; then
    if [ -n "$saved_layout" ]; then
        export XKB_DEFAULT_LAYOUT="$saved_layout"
    else
        case "${LANG:-}" in
            ja*) export XKB_DEFAULT_LAYOUT=jp,us ;;
            ko*) export XKB_DEFAULT_LAYOUT=kr,us ;;
            de*) export XKB_DEFAULT_LAYOUT=de,us ;;
            fr*) export XKB_DEFAULT_LAYOUT=fr,us ;;
            *)   export XKB_DEFAULT_LAYOUT=us ;;
        esac
    fi
fi
if [ -z "${XKB_DEFAULT_OPTIONS:-}" ] && [[ "$XKB_DEFAULT_LAYOUT" == *,* ]]; then
    export XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle
fi
case "$saved_numlock" in
    0|1) export LUNA_NUMLOCK="$saved_numlock" ;;
esac

# Standard Wayland only. Do not preload the repository's experimental client
# into GTK/Firefox/GLFW: Mesa and toolkits expect full system libwayland semantics.
unset LD_PRELOAD LUNA_WAYLAND_CLIENT_PRELOAD LUNA_WAYLAND_CLIENT_LIBPATH

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Luna}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-luna}"
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export MOZ_GTK_TITLEBAR_DECORATION="${MOZ_GTK_TITLEBAR_DECORATION:-client}"
export GDK_SCALE="${LUNA_GDK_SCALE:-1}"
export GDK_DPI_SCALE="${LUNA_GDK_DPI_SCALE:-1}"
export QT_SCALE_FACTOR="${LUNA_QT_SCALE_FACTOR:-1}"
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export LUNA_BACKEND="$BACKEND"
export LUNA_OUTPUT_DPI="${LUNA_OUTPUT_DPI:-96}"

# Client rendering policy.
# DRI: GPU/GL is the default. Software backend: Cairo/llvmpipe.
# Override with LUNA_CLIENT_RENDERER=gpu|software.
# Never leave GSK_RENDERER=vulkan — Luna has no Vulkan WSI for clients.
client_renderer="${LUNA_CLIENT_RENDERER:-auto}"
if [ "$client_renderer" = auto ]; then
    [ "$BACKEND" = dri ] && client_renderer=gpu || client_renderer=software
fi
export LUNA_CLIENT_RENDERER="$client_renderer"
case "$client_renderer" in
    gpu)
        unset LIBGL_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER
        case "${LUNA_GSK_RENDERER:-${GSK_RENDERER:-}}" in
            vulkan|Vulkan|VULKAN|"") export GSK_RENDERER=gl ;;
            *) export GSK_RENDERER="${LUNA_GSK_RENDERER:-$GSK_RENDERER}" ;;
        esac
        ;;
    software)
        export LIBGL_ALWAYS_SOFTWARE=1
        export LP_NUM_THREADS="${LP_NUM_THREADS:-${LUNA_SOFTWARE_THREADS:-4}}"
        export GSK_RENDERER="${LUNA_GSK_RENDERER:-cairo}"
        ;;
    *)
        die "LUNA_CLIENT_RENDERER must be auto, gpu or software"
        ;;
esac

# GLFW's default libdecor choice prefers the GTK plugin.  On a bare VT it
# repeatedly asks GTK for unavailable symbolic titlebar icons, which produces
# NULL dereferences / abort during the first mapped frame of small GL clients.
# Explicit LIBDECOR_PLUGIN_DIR wins; LUNA_LIBDECOR_CAIRO=0 restores auto mode.
case "${LUNA_LIBDECOR_CAIRO:-1}" in
    0|no|false|off) unset LIBDECOR_PLUGIN_DIR ;;
    *)
        if [ -z "${LIBDECOR_PLUGIN_DIR:-}" ]; then
            for _decor in \
                /usr/lib64/libdecor/plugins-1/libdecor-cairo.so \
                /usr/lib/x86_64-linux-gnu/libdecor/plugins-1/libdecor-cairo.so \
                /usr/lib/aarch64-linux-gnu/libdecor/plugins-1/libdecor-cairo.so \
                /usr/lib/libdecor/plugins-1/libdecor-cairo.so \
                /usr/local/lib64/libdecor/plugins-1/libdecor-cairo.so \
                /usr/local/lib/libdecor/plugins-1/libdecor-cairo.so
            do
                if [ -r "$_decor" ]; then
                    _decor_dir="${XDG_RUNTIME_DIR:-/tmp}/luna-libdecor-cairo"
                    mkdir -p -m 700 "$_decor_dir"
                    ln -sfn "$_decor" "$_decor_dir/libdecor-cairo.so"
                    export LIBDECOR_PLUGIN_DIR="$_decor_dir"
                    break
                fi
            done
            unset _decor _decor_dir
        fi
        ;;
esac

# Pure Wayland IME path.
case "${LUNA_IM_WAYLAND:-1}" in
    0|no|false|off) ;;
    *)
        export GTK_IM_MODULE=wayland
        unset QT_IM_MODULE QT4_IM_MODULE CLUTTER_IM_MODULE XMODIFIERS
        ;;
esac

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
    eval "$(dbus-launch --sh-syntax)"
fi

ARGS=(--socket "$SOCKET" --backend "$BACKEND")
[ -n "${LUNA_TTY:-}" ] && [ "$BACKEND" = dri ] && ARGS+=(--tty "$LUNA_TTY")
case "${LUNA_PHYSICAL_INPUT:-1}" in 0|no|false|off) ARGS+=(--no-input) ;; esac
[ -n "$SIZE" ] && ARGS+=(--size "$SIZE")
[ "$BACKEND" = webgl ] && ARGS+=(--port "$PORT")
if [ -z "$FBDEV" ] && [ -e /dev/fb0 ]; then
    case "$BACKEND" in software|dri) FBDEV=/dev/fb0 ;; esac
fi
[ -n "$FBDEV" ] && ARGS+=(--fbdev "$FBDEV")

echo "→ compositor: $COMPOSITOR (${ARGS[*]})"
"$COMPOSITOR" "${ARGS[@]}" &
COMPOSITOR_PID=$!

# Wait for readiness, not an arbitrary startup sleep.
ready=0
for _ in {1..200}; do
    is_running "$COMPOSITOR_PID" || {
        wait "$COMPOSITOR_PID" || true
        die "compositor exited before creating $SOCKET"
    }
    if [ -S "$XDG_RUNTIME_DIR/$SOCKET" ]; then ready=1; break; fi
    sleep 0.005
done
[ "$ready" = 1 ] || die "Wayland socket was not created: $XDG_RUNTIME_DIR/$SOCKET"

export WAYLAND_DISPLAY="$SOCKET"
unset DISPLAY
export PATH="$BIN:$ROOT:$PATH"

# Keep the shell on hardware GL on a DRI session even when application clients
# are explicitly forced to software rendering.
echo "→ shell: $SHELL_BIN"
if [ "$BACKEND" = dri ]; then
    env -u LIBGL_ALWAYS_SOFTWARE -u MESA_LOADER_DRIVER_OVERRIDE -u GALLIUM_DRIVER \
        LUNA_NO_HELPERS=1 "$SHELL_BIN" --desktop &
else
    LUNA_NO_HELPERS=1 "$SHELL_BIN" --desktop &
fi
SHELL_PID=$!

INPUT_METHOD="${LUNA_INPUT_METHOD:-whiz-im-wayland}"
if [ "$INPUT_METHOD" != none ] && [ "$INPUT_METHOD" != 0 ] && command -v "$INPUT_METHOD" >/dev/null 2>&1; then
    "$INPUT_METHOD" &
    INPUT_METHOD_PID=$!
fi

CLIPBOARD="${LUNA_CLIPBOARD:-luna-clipboard}"
if [ "$CLIPBOARD" != none ] && [ "$CLIPBOARD" != 0 ] && command -v "$CLIPBOARD" >/dev/null 2>&1; then
    "$CLIPBOARD" -v &
    CLIPBOARD_PID=$!
fi

if [ -n "${LUNA_APPS:-}" ]; then
    for app in $LUNA_APPS; do
        echo "→ app: $app"
        $app &
        APP_PIDS+=("$!")
    done
fi

[ "$BACKEND" = webgl ] && echo "→ WebGL: http://localhost:$PORT/"

# No 100 ms supervisor poll. Block in the kernel until either core process exits.
wait -n "$COMPOSITOR_PID" "$SHELL_PID" || true
