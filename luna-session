#!/usr/bin/env bash
# Luna Desktop session launcher.
# Runtime supervision is fully event-driven: after startup this process blocks
# in wait(2) and never wakes the desktop on a timer.
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="${PROFILE:-release}"
TARGET="$ROOT/target/$PROFILE"
BACKEND="${BACKEND:-dri}"
SOCKET="${LUNA_SOCKET:-wayland-0}"
PORT="${LUNA_WEBGL_PORT:-8081}"
PIDS=()
COMPOSITOR_PID=
SHELL_PID=

fail() { printf 'luna-session: %s\n' "$*" >&2; exit 1; }
alive() { [[ -n ${1:-} ]] && kill -0 "$1" 2>/dev/null; }

cleanup() {
    local p alive_any
    trap - EXIT INT TERM HUP
    ((${#PIDS[@]})) || return 0

    kill -TERM "${PIDS[@]}" 2>/dev/null || true
    for _ in {1..20}; do
        alive_any=0
        for p in "${PIDS[@]}"; do alive "$p" && alive_any=1; done
        ((alive_any)) || break
        sleep 0.05
    done
    for p in "${PIDS[@]}"; do alive "$p" && kill -KILL "$p" 2>/dev/null || true; done
    for p in "${PIDS[@]}"; do wait "$p" 2>/dev/null || true; done
    rm -f -- "${XDG_RUNTIME_DIR:-/tmp}/$SOCKET" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Runtime directory ---------------------------------------------------------
if [[ -z ${XDG_RUNTIME_DIR:-} ]]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    [[ -d $XDG_RUNTIME_DIR ]] || XDG_RUNTIME_DIR="/tmp/luna-runtime-$(id -u)"
fi
install -d -m 700 "$XDG_RUNTIME_DIR"
export XDG_RUNTIME_DIR

# Resolve binaries.  A source checkout builds once when needed; an installed
# session simply uses PATH.  There is no build/stat polling after launch.
if [[ -n ${LUNA_BIN:-} ]]; then
    BIN="$LUNA_BIN"
elif [[ -f $ROOT/wayland-server-rs/Cargo.toml ]]; then
    BIN="$TARGET"
else
    BIN="$ROOT"
fi

if [[ ! -x $BIN/luna-compositor || ! -x $BIN/luna-shell ]]; then
    if [[ -f $ROOT/Makefile ]]; then
        printf '→ Building Luna desktop\n'
        make -C "$ROOT" build-desktop-system PROFILE="$PROFILE"
        BIN="$TARGET"
    else
        COMPOSITOR_PATH="$(command -v luna-compositor || true)"
        SHELL_PATH="$(command -v luna-shell || true)"
        [[ -n $COMPOSITOR_PATH && -n $SHELL_PATH ]] || fail 'Luna binaries not found'
        BIN="$(dirname -- "$COMPOSITOR_PATH")"
    fi
fi

COMPOSITOR="${LUNA_COMPOSITOR:-$BIN/luna-compositor}"
SHELL_BIN="${LUNA_SHELL:-$BIN/luna-shell}"
[[ -x $COMPOSITOR ]] || fail "not executable: $COMPOSITOR"
[[ -x $SHELL_BIN ]] || fail "not executable: $SHELL_BIN"

# Small subset of settings required before the compositor starts.
SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/luna-shell/settings.conf"
saved_lang= saved_layout= saved_numlock=
if [[ -r $SETTINGS ]]; then
    while IFS='=' read -r key value; do
        case "$key" in
            ui_language) saved_lang="$value" ;;
            kb_layout)   saved_layout="$value" ;;
            numlock_on)  saved_numlock="$value" ;;
        esac
    done < "$SETTINGS"
fi
case "$saved_lang" in
    ja_JP.UTF-8|en_US.UTF-8|C.UTF-8) export LANG="$saved_lang" LC_ALL="$saved_lang" ;;
    '') : ;;
esac
if [[ -z ${XKB_DEFAULT_LAYOUT:-} ]]; then
    if [[ -n $saved_layout ]]; then
        export XKB_DEFAULT_LAYOUT="$saved_layout"
    else
        case "${LANG:-}" in
            ja*) export XKB_DEFAULT_LAYOUT=jp,us ;;
            ko*) export XKB_DEFAULT_LAYOUT=kr,us ;;
            de*) export XKB_DEFAULT_LAYOUT=de,us ;;
            fr*) export XKB_DEFAULT_LAYOUT=fr,us ;;
            *)   export XKB_DEFAULT_LAYOUT=us ;;
        esac
    fi
fi
[[ -n ${XKB_DEFAULT_OPTIONS:-} || $XKB_DEFAULT_LAYOUT != *,* ]] || \
    export XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle
case "$saved_numlock" in 0|1) export LUNA_NUMLOCK="$saved_numlock" ;; esac

# Native Wayland environment ------------------------------------------------
unset LD_PRELOAD LUNA_WAYLAND_CLIENT_PRELOAD LUNA_WAYLAND_CLIENT_LIBPATH DISPLAY
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Luna}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-luna}"
export GDK_BACKEND=wayland QT_QPA_PLATFORM=wayland MOZ_ENABLE_WAYLAND=1
export GDK_SCALE="${LUNA_GDK_SCALE:-1}" GDK_DPI_SCALE="${LUNA_GDK_DPI_SCALE:-1}"
export QT_SCALE_FACTOR="${LUNA_QT_SCALE_FACTOR:-1}" QT_AUTO_SCREEN_SCALE_FACTOR=0
export LUNA_BACKEND="$BACKEND" LUNA_OUTPUT_DPI="${LUNA_OUTPUT_DPI:-96}"
# New monitor defaults to silent background sampling.  Set to 1 only when
# deliberately benchmarking continuously ticking CPU/memory widgets.
export LUNA_MONITOR_LIVE_NOTIFY="${LUNA_MONITOR_LIVE_NOTIFY:-0}"

renderer="${LUNA_CLIENT_RENDERER:-auto}"
[[ $renderer != auto ]] || { [[ $BACKEND == dri ]] && renderer=gpu || renderer=software; }
export LUNA_CLIENT_RENDERER="$renderer"
case "$renderer" in
    gpu)
        unset LIBGL_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER
        [[ ${GSK_RENDERER:-} != vulkan && -n ${GSK_RENDERER:-} ]] || export GSK_RENDERER=gl
        ;;
    software)
        export LIBGL_ALWAYS_SOFTWARE=1
        export LP_NUM_THREADS="${LP_NUM_THREADS:-${LUNA_SOFTWARE_THREADS:-4}}"
        export GSK_RENDERER="${LUNA_GSK_RENDERER:-cairo}"
        ;;
    *) fail 'LUNA_CLIENT_RENDERER must be auto, gpu or software' ;;
esac

case "${LUNA_IM_WAYLAND:-1}" in
    0|no|false|off) ;;
    *) export GTK_IM_MODULE=wayland; unset QT_IM_MODULE QT4_IM_MODULE CLUTTER_IM_MODULE XMODIFIERS ;;
esac
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v dbus-launch >/dev/null 2>&1; then
    eval "$(dbus-launch --sh-syntax)"
fi

# Compositor ---------------------------------------------------------------
ARGS=(--socket "$SOCKET" --backend "$BACKEND")
[[ -z ${LUNA_TTY:-} || $BACKEND != dri ]] || ARGS+=(--tty "$LUNA_TTY")
case "${LUNA_PHYSICAL_INPUT:-1}" in 0|no|false|off) ARGS+=(--no-input) ;; esac
[[ -z ${LUNA_SIZE:-} ]] || ARGS+=(--size "$LUNA_SIZE")
[[ $BACKEND != webgl ]] || ARGS+=(--port "$PORT")
if [[ -n ${LUNA_FBDEV:-} ]]; then
    ARGS+=(--fbdev "$LUNA_FBDEV")
elif [[ -e /dev/fb0 && ( $BACKEND == dri || $BACKEND == software ) ]]; then
    ARGS+=(--fbdev /dev/fb0)
fi

printf '→ compositor: %s %s\n' "$COMPOSITOR" "${ARGS[*]}"
"$COMPOSITOR" "${ARGS[@]}" & COMPOSITOR_PID=$!; PIDS+=("$COMPOSITOR_PID")

# Startup readiness is the only polling in this launcher.  It ends as soon as
# the Wayland socket exists and is never part of steady-state rendering.
for _ in {1..400}; do
    alive "$COMPOSITOR_PID" || { wait "$COMPOSITOR_PID" || true; fail 'compositor exited during startup'; }
    [[ -S $XDG_RUNTIME_DIR/$SOCKET ]] && break
    sleep 0.005
done
[[ -S $XDG_RUNTIME_DIR/$SOCKET ]] || fail "Wayland socket not created: $SOCKET"
export WAYLAND_DISPLAY="$SOCKET"
export PATH="$BIN:$ROOT:$PATH"

# Shell and optional helpers -----------------------------------------------
printf '→ shell: %s\n' "$SHELL_BIN"
if [[ $BACKEND == dri ]]; then
    env -u LIBGL_ALWAYS_SOFTWARE -u MESA_LOADER_DRIVER_OVERRIDE -u GALLIUM_DRIVER \
        LUNA_NO_HELPERS=1 "$SHELL_BIN" --desktop &
else
    LUNA_NO_HELPERS=1 "$SHELL_BIN" --desktop &
fi
SHELL_PID=$!; PIDS+=("$SHELL_PID")

start_optional() {
    local exe="$1"; shift
    [[ $exe != none && $exe != 0 ]] || return 0
    command -v "$exe" >/dev/null 2>&1 || return 0
    "$exe" "$@" & PIDS+=("$!")
}
start_optional "${LUNA_INPUT_METHOD:-whiz-im-wayland}"
start_optional "${LUNA_CLIPBOARD:-luna-clipboard}"

if [[ -n ${LUNA_APPS:-} ]]; then
    for app in $LUNA_APPS; do
        printf '→ app: %s\n' "$app"
        "$app" & PIDS+=("$!")
    done
fi
[[ $BACKEND != webgl ]] || printf '→ WebGL: http://localhost:%s/\n' "$PORT"

# Steady state: one blocking wait, zero supervisor timer wakeups.
wait -n "$COMPOSITOR_PID" "$SHELL_PID" || true
