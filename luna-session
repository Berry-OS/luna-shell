#!/bin/bash
# Copyright © 2026 Yuichiro Nakada / Project Luna (Vespera)
#
# Luna Desktop session launcher.
# Starts the compositor (luna-compositor), desktop shell (luna-shell),
# and optional apps — right after kernel boot, instead of Xorg/Weston.
#
# Usage:
#   ./luna-session                              # DRI compositor + luna-shell
#   BACKEND=software ./luna-session             # software compositor (dev / VM)
#   LUNA_USE_SYSTEM_WAYLAND=1 ./luna-session  # GTK/GLFW via system libwayland-*
#   LUNA_ENABLE_DMABUF=1 ./luna-session        # opt-in LINEAR dmabuf (GTK); off by default
#   LUNA_APPS="hello-gtk" ./luna-session        # launch GTK apps after shell
#   INSTALL_PREFIX=/usr/local make install && luna-session

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="${PROFILE:-release}"
# Source-tree cargo output (only present when running from the repo).
SOURCE_TARGET="$SCRIPT_DIR/target/$PROFILE"
BACKEND="${BACKEND:-dri}"
SOCKET="${LUNA_SOCKET:-wayland-0}"
SIZE="${LUNA_SIZE:-}"
PORT="${LUNA_WEBGL_PORT:-}"
FBDEV="${LUNA_FBDEV:-}"

# Resolve BIN / LIB for both layouts:
#   installed:  $PREFIX/bin/{luna-session,luna-compositor,luna-shell}
#               $PREFIX/lib/luna/libwayland*.so
#   source:     $SCRIPT_DIR/luna-session
#               $SCRIPT_DIR/target/$PROFILE/{luna-compositor,libwayland*.so}
#
# Bug (fixed): INSTALL_PREFIX defaulted to SCRIPT_DIR, so an installed
# /usr/local/bin/luna-session looked for /usr/local/bin/bin/luna-compositor.
resolve_paths() {
    if [ -n "${LUNA_BIN:-}" ]; then
        BIN="$LUNA_BIN"
    elif [ -n "${INSTALL_PREFIX:-}" ]; then
        BIN="$INSTALL_PREFIX/bin"
    elif [ -x "$SCRIPT_DIR/luna-compositor" ]; then
        # Installed next to this script (e.g. /usr/local/bin)
        BIN="$SCRIPT_DIR"
    elif [ -x "$SOURCE_TARGET/luna-compositor" ]; then
        BIN="$SOURCE_TARGET"
    else
        BIN=""
    fi

    if [ -n "${LUNA_LIB:-}" ]; then
        LIB="$LUNA_LIB"
    elif [ -n "${INSTALL_PREFIX:-}" ]; then
        LIB="$INSTALL_PREFIX/lib/luna"
    elif [ -n "$BIN" ] && [ -d "$BIN/../lib/luna" ]; then
        LIB="$(cd "$BIN/../lib/luna" && pwd)"
    elif [ -d "$SOURCE_TARGET" ]; then
        LIB="$SOURCE_TARGET"
    else
        LIB=""
    fi

    # Dev symlink dir for PATH / vendored client discovery.
    if [ -d "$SOURCE_TARGET" ]; then
        TARGET="$SOURCE_TARGET"
    else
        TARGET="$BIN"
    fi
}

resolve_paths

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

COMPOSITOR_PID=""
SHELL_PID=""
INPUT_METHOD_PID=""
CLIPBOARD_PID=""
APP_PIDS=()
USE_SYSTEM_WAYLAND=0
VENDORED_CLIENT=""
CLEANING=0

process_running() {
    local pid="$1" state
    kill -0 "$pid" 2>/dev/null || return 1
    state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
    [ -n "$state" ] && [[ "$state" != Z* ]]
}

cleanup() {
    [ "$CLEANING" = "0" ] || return
    CLEANING=1
    local pids=()
    for pid in "${APP_PIDS[@]}"; do
        [ -n "$pid" ] && pids+=("$pid")
    done
    [ -n "$INPUT_METHOD_PID" ] && pids+=("$INPUT_METHOD_PID")
    [ -n "$CLIPBOARD_PID" ] && pids+=("$CLIPBOARD_PID")
    [ -n "$SHELL_PID" ] && pids+=("$SHELL_PID")
    [ -n "$COMPOSITOR_PID" ] && pids+=("$COMPOSITOR_PID")
    for pid in "${pids[@]}"; do
        kill -TERM "$pid" 2>/dev/null || true
    done
    # Give the compositor time to restore CRTC/KD/VT state before escalation.
    for _ in $(seq 1 30); do
        local alive=0
        for pid in "${pids[@]}"; do
            process_running "$pid" && alive=1
        done
        [ "$alive" = "1" ] || break
        sleep 0.1
    done
    for pid in "${pids[@]}"; do
        if process_running "$pid"; then
            echo "warning: process $pid did not stop; sending KILL"
            kill -KILL "$pid" 2>/dev/null || true
        fi
    done
    for pid in "${pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
    [ "$USE_SYSTEM_WAYLAND" = "1" ] || rm -f "$XDG_RUNTIME_DIR/$SOCKET"
}
trap cleanup EXIT INT TERM

has_system_wayland_client() {
    ldconfig -p 2>/dev/null | grep -q 'libwayland-client\.so\.0' \
        || [ -f /usr/lib/x86_64-linux-gnu/libwayland-client.so.0 ] \
        || [ -f /usr/lib/aarch64-linux-gnu/libwayland-client.so.0 ] \
        || [ -f /usr/lib/libwayland-client.so.0 ]
}

resolve_vendored_client() {
    local candidates=()
    [ -n "${LIB:-}" ] && candidates+=("$LIB/libwayland-client.so.0" "$LIB/libwayland_client.so")
    [ -n "${TARGET:-}" ] && candidates+=("$TARGET/libwayland-client.so.0" "$TARGET/libwayland_client.so")
    for candidate in "${candidates[@]}"; do
        if [ -f "$candidate" ] || [ -L "$candidate" ]; then
            # Follow symlink to a real file when possible.
            if [ -f "$candidate" ]; then
                echo "$candidate"
                return 0
            fi
            local real
            real="$(readlink -f "$candidate" 2>/dev/null || true)"
            if [ -n "$real" ] && [ -f "$real" ]; then
                echo "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

resolve_wayland_client_mode() {
    case "${LUNA_USE_SYSTEM_WAYLAND:-auto}" in
        1|yes|true|system)
            USE_SYSTEM_WAYLAND=1
            ;;
        0|no|false|vendored)
            USE_SYSTEM_WAYLAND=0
            ;;
        auto|*)
            # Prefer system libwayland: Mesa EGL (Firefox/Chrome) needs real
            # prepare_read / event queues.  Vendored client is opt-in for
            # debugging (LUNA_USE_SYSTEM_WAYLAND=0).
            if has_system_wayland_client; then
                USE_SYSTEM_WAYLAND=1
            elif VENDORED_CLIENT="$(resolve_vendored_client)"; then
                USE_SYSTEM_WAYLAND=0
            else
                echo "→ No vendored libwayland-client and system libwayland-client not found"
                echo "  Build vendored client: make -C \"$SCRIPT_DIR\" build"
                echo "  Or install system libs: apt install libwayland-client0"
                exit 1
            fi
            ;;
    esac

    if [ "$USE_SYSTEM_WAYLAND" = "0" ]; then
        VENDORED_CLIENT="${VENDORED_CLIENT:-$(resolve_vendored_client || true)}"
        if [ -z "$VENDORED_CLIENT" ]; then
            if has_system_wayland_client; then
                echo "→ Vendored libwayland-client missing; falling back to system libwayland-client"
                USE_SYSTEM_WAYLAND=1
            else
                echo "→ Building vendored libwayland-client..."
                make -C "$SCRIPT_DIR" build PROFILE="$PROFILE"
                VENDORED_CLIENT="$(resolve_vendored_client)" || {
                    echo "error: failed to build libwayland_client.so"
                    exit 1
                }
            fi
        fi
    fi
}

if [ -z "${BIN:-}" ] || [ ! -x "$BIN/luna-compositor" ]; then
    if [ -f "$SCRIPT_DIR/Makefile" ]; then
        echo "→ Luna compositor not found; building from source..."
        make -C "$SCRIPT_DIR" build-dri PROFILE="$PROFILE"
        BIN="$SOURCE_TARGET"
        LIB="$SOURCE_TARGET"
        TARGET="$SOURCE_TARGET"
    else
        echo "error: luna-compositor not found"
        echo "  looked next to session: $SCRIPT_DIR/luna-compositor"
        echo "  and in source target:   $SOURCE_TARGET/luna-compositor"
        echo "  Install:  make install PREFIX=/usr/local"
        echo "  Or override: LUNA_BIN=/usr/local/bin luna-session"
        exit 1
    fi
fi

COMPOSITOR="$BIN/luna-compositor"
SHELL_BIN="$BIN/luna-shell"
[ -x "$SHELL_BIN" ] || SHELL_BIN="$SCRIPT_DIR/luna-shell"
if [ ! -x "$SHELL_BIN" ]; then
    echo "error: luna-shell not found (tried $BIN/luna-shell and $SCRIPT_DIR/luna-shell)"
    exit 1
fi

echo "→ Paths: BIN=$BIN  LIB=${LIB:-"(none)"}  COMPOSITOR=$COMPOSITOR"

resolve_wayland_client_mode

# Ensure dev symlinks exist when using the vendored client from target/.
if [ "$USE_SYSTEM_WAYLAND" = "0" ] && [ -d "$TARGET" ]; then
    ln -sf libwayland_client.so "$TARGET/libwayland-client.so.0" 2>/dev/null || true
    ln -sf libwayland_client.so "$TARGET/libwayland-client.so" 2>/dev/null || true
fi

COMPOSITOR_ARGS=(--socket "$SOCKET" --backend "$BACKEND")
if [ "$BACKEND" = "dri" ] && [ -n "${LUNA_TTY:-}" ]; then
    COMPOSITOR_ARGS+=(--tty "$LUNA_TTY")
fi
case "${LUNA_PHYSICAL_INPUT:-1}" in
    0|no|false|off) COMPOSITOR_ARGS+=(--no-input) ;;
esac
if [ -n "$SIZE" ]; then
    COMPOSITOR_ARGS+=(--size "$SIZE")
fi
if [ "$BACKEND" = "webgl" ]; then
    COMPOSITOR_ARGS+=(--port "${PORT:-8081}")
fi
# Software / DRI-fallback needs an output target; default to /dev/fb0 when present.
if [ -z "$FBDEV" ] && [ -e /dev/fb0 ]; then
    case "$BACKEND" in
        software|dri) FBDEV=/dev/fb0 ;;
    esac
fi
if [ -n "$FBDEV" ]; then
    COMPOSITOR_ARGS+=(--fbdev "$FBDEV")
fi

# Locale: Xorg sessions get this from berryos-xsession / PAM; a raw VT does not.
export LANG="${LANG:-ja_JP.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-$LANG}"

# Keyboard layout (XKB). Compositor embeds this into wl_keyboard.keymap.
# Multilingual: comma-separated layouts (e.g. jp,us) with Alt+Shift to toggle.
# Override anytime with XKB_DEFAULT_LAYOUT / VARIANT / OPTIONS.
if [ -z "${XKB_DEFAULT_LAYOUT:-}" ]; then
    # Keyboard hardware and message locale are independent.  Berry images use
    # LANG=C.UTF-8 but record the actual console/XKB layout in vconsole.conf;
    # relying on LANG alone consequently turned a configured JIS keyboard into
    # US at every Luna login.  Read the system keyboard setting without
    # sourcing either config file as shell code.
    _system_xkb_layout=""
    for _keyboard_conf in /etc/vconsole.conf /etc/default/keyboard; do
        [ -r "$_keyboard_conf" ] || continue
        while IFS='=' read -r _keyboard_key _keyboard_value; do
            case "$_keyboard_key" in
                XKBLAYOUT|XKBLAYOUT\ |KEYMAP|KEYMAP\ ) ;;
                *) continue ;;
            esac
            _keyboard_value="${_keyboard_value#\"}"
            _keyboard_value="${_keyboard_value%\"}"
            _keyboard_value="${_keyboard_value#\'}"
            _keyboard_value="${_keyboard_value%\'}"
            case "$_keyboard_value" in
                jp|jp106|jp*) _system_xkb_layout=jp,us ;;
                us|us*)       _system_xkb_layout=us ;;
                de|de*)       _system_xkb_layout=de,us ;;
                fr|fr*)       _system_xkb_layout=fr,us ;;
                kr|kr*)       _system_xkb_layout=kr,us ;;
                ?*[,]*|??)    _system_xkb_layout="$_keyboard_value" ;;
            esac
            [ -z "$_system_xkb_layout" ] || break
        done < "$_keyboard_conf"
        [ -z "$_system_xkb_layout" ] || break
    done
    if [ -n "$_system_xkb_layout" ]; then
        export XKB_DEFAULT_LAYOUT="$_system_xkb_layout"
    else
        case "${LANG}" in
            ja*|JA*) export XKB_DEFAULT_LAYOUT=jp,us ;;
            ko*|KO*) export XKB_DEFAULT_LAYOUT=kr,us ;;
            zh_CN*|zh_SG*) export XKB_DEFAULT_LAYOUT=cn,us ;;
            zh_TW*|zh_HK*) export XKB_DEFAULT_LAYOUT=tw,us ;;
            de*|DE*) export XKB_DEFAULT_LAYOUT=de,us ;;
            fr*|FR*) export XKB_DEFAULT_LAYOUT=fr,us ;;
            es*|ES*) export XKB_DEFAULT_LAYOUT=es,us ;;
            pt_BR*) export XKB_DEFAULT_LAYOUT=br,us ;;
            ru*|RU*) export XKB_DEFAULT_LAYOUT=us,ru ;;
            ar*|AR*) export XKB_DEFAULT_LAYOUT=us,ara ;;
            *)       export XKB_DEFAULT_LAYOUT=us ;;
        esac
    fi
    unset _system_xkb_layout _keyboard_conf _keyboard_key _keyboard_value
fi
if [ -z "${XKB_DEFAULT_OPTIONS:-}" ] && echo "$XKB_DEFAULT_LAYOUT" | grep -q ','; then
    export XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle
fi
echo "→ Keyboard: XKB_DEFAULT_LAYOUT=$XKB_DEFAULT_LAYOUT${XKB_DEFAULT_OPTIONS:+ options=$XKB_DEFAULT_OPTIONS}"

# Session bus (portal / some GTK apps expect it; X sessions start it via xinitrc.d).
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
    eval "$(dbus-launch --sh-syntax)"
fi

# Identify as Luna (not GNOME).  GNOME's default WM button-layout is
# appmenu:close — xdg-desktop-portal maps that to gtk-decoration-layout and
# GTK CSD HeaderBars then hide minimize/maximize.
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Luna}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-luna}"

# GTK CSD title-bar buttons (HeaderBar / WindowControls).
# Override with LUNA_GTK_BUTTON_LAYOUT=':close' for GNOME-style close-only.
LUNA_GTK_BUTTON_LAYOUT="${LUNA_GTK_BUTTON_LAYOUT:-icon:minimize,maximize,close}"
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.wm.preferences button-layout \
        "$LUNA_GTK_BUTTON_LAYOUT" 2>/dev/null \
        && echo "→ GTK CSD buttons: $LUNA_GTK_BUTTON_LAYOUT" \
        || true
fi
# settings.ini fallback when portals are absent (gtk reads these directly).
for _gtk_ver in gtk-3.0 gtk-4.0; do
    _gtk_dir="${XDG_CONFIG_HOME:-$HOME/.config}/$_gtk_ver"
    _gtk_ini="$_gtk_dir/settings.ini"
    mkdir -p "$_gtk_dir"
    if [ ! -f "$_gtk_ini" ]; then
        printf '[Settings]\ngtk-decoration-layout=%s\n' \
            "$LUNA_GTK_BUTTON_LAYOUT" > "$_gtk_ini"
    elif ! grep -q '^gtk-decoration-layout=' "$_gtk_ini" 2>/dev/null; then
        grep -q '^\[Settings\]' "$_gtk_ini" 2>/dev/null \
            || printf '\n[Settings]\n' >> "$_gtk_ini"
        printf 'gtk-decoration-layout=%s\n' "$LUNA_GTK_BUTTON_LAYOUT" >> "$_gtk_ini"
    fi
done
unset _gtk_ver _gtk_dir _gtk_ini

# Toolkit / browser hints for the whole session (sakura → firefox inherits these).
# luna-session is pure Wayland — no Xwayland — so clients must not look for DISPLAY.
export GDK_BACKEND="${GDK_BACKEND:-wayland}"
export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
export MOZ_LAYERS_ALLOW_SOFTWARE_GL="${MOZ_LAYERS_ALLOW_SOFTWARE_GL:-1}"
# Compositor holds DRM master; hardware EGL in clients yields fd=-1 and Firefox
# hangs in WaitFlushedEvent.  Force the generic Mesa software path for session
# children, but do not pin both the loader and Gallium driver: that combination
# is not portable across Mesa builds and has caused client startup crashes.
# Browser launchers below keep their stricter, known-good overrides.
export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
# On many-core machines llvmpipe otherwise creates roughly one worker per CPU
# for every application.  Luna's mostly-2D clients are smoother with a small,
# bounded pool and no longer starve the compositor.  Explicit user values win.
export LP_NUM_THREADS="${LP_NUM_THREADS:-${LUNA_SOFTWARE_THREADS:-4}}"
export MOZ_WEBRENDER="${MOZ_WEBRENDER:-0}"
export MOZ_ACCELERATED="${MOZ_ACCELERATED:-0}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
# Force overwrite: console/logind leaves XDG_SESSION_TYPE=tty, and
# ${VAR:-wayland} would keep it.  Chrome then defaults to ozone/x11 and
# needs --ozone-platform=wayland; with this set it auto-selects Wayland.
export XDG_SESSION_TYPE=wayland
export GDK_SCALE="${GDK_SCALE:-1}"
export GDK_DPI_SCALE="${GDK_DPI_SCALE:-1}"
export QT_SCALE_FACTOR="${QT_SCALE_FACTOR:-1}"
export QT_AUTO_SCREEN_SCALE_FACTOR="${QT_AUTO_SCREEN_SCALE_FACTOR:-0}"
# Berry often exports GSK_RENDERER=vulkan; Luna clients have no Vulkan WSI
# (dmabuf off → wl_shm), so GTK4/Firefox dialogs stall.  Prefer Cairo.
case "${GSK_RENDERER:-}" in
    ""|vulkan|Vulkan|VULKAN) export GSK_RENDERER=cairo ;;
esac

# GLFW's default libdecor choice prefers the GTK plugin.  On a bare VT it
# repeatedly asks GTK for unavailable symbolic titlebar icons, which produces
# critical warnings and can terminate small Luna GL applications.  The Cairo
# plugin provides the same client-side decorations without the GTK dependency.
# Explicit LIBDECOR_PLUGIN_DIR wins; LUNA_LIBDECOR_CAIRO=0 restores auto mode.
case "${LUNA_LIBDECOR_CAIRO:-1}" in
    0|no|false|off) ;;
    *)
        if [ -z "${LIBDECOR_PLUGIN_DIR:-}" ]; then
            for _decor_plugin in \
                /usr/lib64/libdecor/plugins-1/libdecor-cairo.so \
                /usr/lib/x86_64-linux-gnu/libdecor/plugins-1/libdecor-cairo.so \
                /usr/lib/aarch64-linux-gnu/libdecor/plugins-1/libdecor-cairo.so \
                /usr/lib/libdecor/plugins-1/libdecor-cairo.so \
                /usr/local/lib64/libdecor/plugins-1/libdecor-cairo.so \
                /usr/local/lib/libdecor/plugins-1/libdecor-cairo.so
            do
                [ -f "$_decor_plugin" ] || continue
                _decor_dir="$XDG_RUNTIME_DIR/luna-libdecor-cairo"
                mkdir -p "$_decor_dir"
                ln -sf "$_decor_plugin" "$_decor_dir/libdecor-cairo.so"
                export LIBDECOR_PLUGIN_DIR="$_decor_dir"
                echo "→ GLFW decorations: libdecor-cairo"
                break
            done
            unset _decor_plugin _decor_dir
        fi
        ;;
esac
# wl_output physical size uses this (compositor); 96 ≈ typical Xorg look.
# MUST be exported before the compositor forks so wl_output.geometry is correct.
export LUNA_OUTPUT_DPI="${LUNA_OUTPUT_DPI:-96}"

# Japanese IME: Luna is pure Wayland — apps must use text-input-v3 so the
# compositor can relay preedit/commit to whiz-im-wayland (apps/whiz/im-wayland.c).
#
# A console / Berry X session often exports GTK_IM_MODULE=gim (in-process X11
# Whiz).  That bypasses text-input-v3, so whiz-im-wayland sits idle and JP
# input dies.  Force the Wayland IM module unless the user opts out.
#
#   default / LUNA_IM_WAYLAND=1  → GTK_IM_MODULE=wayland → whiz-im-wayland
#   LUNA_IM_WAYLAND=0           → keep gim/whiz in-process (X11-style)
case "${LUNA_IM_WAYLAND:-1}" in
    0|no|false|off|gim|whiz)
        case "${GTK_IM_MODULE:-}" in
            ""|wayland|none|simple) export GTK_IM_MODULE=gim ;;
        esac
        case "${QT_IM_MODULE:-}" in
            ""|wayland|none) export QT_IM_MODULE=gim ;;
        esac
        export QT4_IM_MODULE="${QT4_IM_MODULE:-whiz}"
        export CLUTTER_IM_MODULE="${CLUTTER_IM_MODULE:-whiz}"
        export XMODIFIERS="${XMODIFIERS:-@im=whiz}"
        echo "→ IME: GTK_IM_MODULE=$GTK_IM_MODULE QT_IM_MODULE=$QT_IM_MODULE (in-process; LUNA_IM_WAYLAND=0)"
        ;;
    *)
        export GTK_IM_MODULE=wayland
        unset QT_IM_MODULE QT4_IM_MODULE CLUTTER_IM_MODULE XMODIFIERS
        echo "→ IME: GTK_IM_MODULE=wayland (text-input-v3 → whiz-im-wayland)"
        ;;
esac

echo "→ Starting Luna compositor (backend=$BACKEND, socket=$SOCKET${FBDEV:+, fbdev=$FBDEV}, dpi=$LUNA_OUTPUT_DPI)"
if [ "$BACKEND" = "dri" ]; then
    # Another compositor holding DRM master makes card0 fail and can leave
    # Mesa on the wrong GPU — the classic luna-shell segfault path.
    for card in /dev/dri/card0 /dev/dri/card1 /dev/dri/card2; do
        [ -e "$card" ] || continue
        holders="$(fuser "$card" 2>/dev/null || true)"
        if [ -n "$holders" ]; then
            echo "warning: $card is already open (pids:$holders)"
            echo "  Stop wayback/weston/Xorg on this seat, or switch to a free VT, before luna-session."
            break
        fi
    done
fi
"$COMPOSITOR" "${COMPOSITOR_ARGS[@]}" &
COMPOSITOR_PID=$!
sleep 0.6
if ! kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
    echo "error: luna-compositor exited immediately (check DRM master / VT / journal)"
    echo "  Tip: stop other graphical sessions, switch to a free VT, or use BACKEND=software"
    wait "$COMPOSITOR_PID" || true
    exit 1
fi

export WAYLAND_DISPLAY="$SOCKET"
unset DISPLAY
export LUNA_BACKEND="$BACKEND"
setup_egl_env() {
    export EGL_PLATFORM="${EGL_PLATFORM:-wayland}"
    case "${LUNA_EGL_SOFTWARE:-auto}" in
        1|yes|true|on)
            export LIBGL_ALWAYS_SOFTWARE=1
            ;;
        0|no|false|off)
            ;;
        auto|*)
            if [ "$BACKEND" = "software" ]; then
                export LIBGL_ALWAYS_SOFTWARE=1
            fi
            ;;
    esac
}
setup_egl_env

if [ "$USE_SYSTEM_WAYLAND" = "1" ]; then
    echo "→ Wayland clients: system libwayland-client"
    unset LD_PRELOAD
    unset LUNA_WAYLAND_CLIENT_PRELOAD
    unset LUNA_WAYLAND_CLIENT_LIBPATH
else
    echo "→ Wayland clients: vendored libwayland-client ($VENDORED_CLIENT)"
    export LUNA_WAYLAND_CLIENT_PRELOAD="$VENDORED_CLIENT"
    export LUNA_WAYLAND_CLIENT_LIBPATH="$LIB"
    # Do NOT put $LIB on LD_LIBRARY_PATH for the whole session.
    # luna-shell must resolve system libwayland-client.so.0 (Mesa EGL);
    # the vendored client shadows it and eglInitialize fails with
    # "[luna-shell/wl] eglInitialize failed". GTK/Firefox get the vendored
    # path via LUNA_WAYLAND_CLIENT_LIBPATH → luna-shell child_session_env,
    # and via the per-app LD_LIBRARY_PATH below for LUNA_APPS.
    unset LD_PRELOAD
fi

# Make sample apps (hello-gtk) and installed binaries reachable for dock/launchpad.
# SCRIPT_DIR covers source-tree luna-shell / luna-clipboard before install.
export PATH="$BIN${TARGET:+:$TARGET}:$SCRIPT_DIR:$PATH"

# Cursor theme folders (.cur/.ani). Shell default is embedded "aero";
# GUI Settings → Display can switch to miku (or another folder under LUNA_CURSOR_PATH).
if [ -z "${LUNA_CURSOR_PATH:-}" ]; then
    for cand in \
        "${INSTALL_PREFIX:-}/share/luna-desktop/cursors" \
        "$SCRIPT_DIR/../share/luna-desktop/cursors" \
        "$BIN/../share/luna-desktop/cursors" \
        "$SCRIPT_DIR/cursors" \
        "/usr/local/share/luna-desktop/cursors" \
        "/usr/share/luna-desktop/cursors"
    do
        [ -n "$cand" ] || continue
        if [ -d "$cand" ]; then
            export LUNA_CURSOR_PATH="$(cd "$cand" && pwd)"
            break
        fi
    done
fi
# Do not force LUNA_CURSOR_THEME here — luna-shell reads ~/.config/luna-shell/settings.conf
# so the Settings GUI can switch themes. Explicit env still works as a one-shot override
# only if the user exports it before launching luna-session.
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

echo "→ Starting Luna shell ($SHELL_BIN)"
# luna-shell links system libwayland + Mesa EGL; never preload or LD_LIBRARY_PATH
# the vendored client into it (that yields eglInitialize failure).
# Strip $LIB from any inherited LD_LIBRARY_PATH as well.
# LUNA_NO_HELPERS: session starts whiz-im-wayland + luna-clipboard itself.
# On dri, also strip software-GL overrides so the shell can use the GPU; clients
# keep LIBGL_ALWAYS_SOFTWARE from the session env (Firefox WaitFlushedEvent fix).
_shell_ld_path="${LD_LIBRARY_PATH:-}"
if [ -n "${LIB:-}" ] && [ -n "$_shell_ld_path" ]; then
    _shell_ld_path="$(printf '%s' "$_shell_ld_path" | tr ':' '\n' | grep -vxF "$LIB" | paste -sd: - || true)"
fi
_shell_env=(env -u LD_PRELOAD)
if [ "$BACKEND" = "dri" ]; then
    _shell_env+=(-u LIBGL_ALWAYS_SOFTWARE -u MESA_LOADER_DRIVER_OVERRIDE -u GALLIUM_DRIVER)
fi
if [ -n "$_shell_ld_path" ]; then
    "${_shell_env[@]}" LD_LIBRARY_PATH="$_shell_ld_path" LUNA_NO_HELPERS=1 "$SHELL_BIN" --desktop &
else
    "${_shell_env[@]}" -u LD_LIBRARY_PATH LUNA_NO_HELPERS=1 "$SHELL_BIN" --desktop &
fi
unset _shell_ld_path _shell_env
SHELL_PID=$!
sleep 0.3
if ! kill -0 "$SHELL_PID" 2>/dev/null; then
    echo "error: luna-shell exited immediately"
    echo "  Common cause: Mesa tried to export a dmabuf the compositor cannot use"
    echo "  (LINEAR-only CPU composite + OpenGL, or the wrong GPU on a multi-GPU box)."
    echo "  Dmabuf is off by default now; if you set LUNA_ENABLE_DMABUF=1, unset it."
    echo "  Also try:"
    echo "    LUNA_DRM_DEVICE=/dev/dri/renderD129 $0       # pick the GPU explicitly"
    echo "    LUNA_EGL_SOFTWARE=1 LUNA_USE_SYSTEM_WAYLAND=1 $0"
    echo "    stop other compositors (wayback/weston) that hold DRM master"
    wait "$SHELL_PID" || true
    exit 1
fi

# A Wayland input method is a regular client with a privileged compositor
# protocol. Start Whiz when installed; set LUNA_INPUT_METHOD=none to opt out,
# or provide an absolute path/custom command name.
# Do NOT LD_PRELOAD the vendored libwayland into whiz — it is a normal GTK
# client against system libwayland / text-input-v3 (preload makes it exit).
INPUT_METHOD="${LUNA_INPUT_METHOD:-whiz-im-wayland}"
if [ "$INPUT_METHOD" != "none" ] && [ "$INPUT_METHOD" != "0" ]; then
    if command -v "$INPUT_METHOD" >/dev/null 2>&1; then
        echo "→ Starting input method ($INPUT_METHOD)"
        env -u LD_PRELOAD "$INPUT_METHOD" &
        INPUT_METHOD_PID=$!
        sleep 0.1
        if ! kill -0 "$INPUT_METHOD_PID" 2>/dev/null; then
            echo "warning: input method exited immediately; continuing without IME"
            wait "$INPUT_METHOD_PID" || true
            INPUT_METHOD_PID=""
        fi
    elif [ -n "${LUNA_INPUT_METHOD:-}" ]; then
        echo "warning: LUNA_INPUT_METHOD not found: $INPUT_METHOD"
    else
        echo "warning: whiz-im-wayland not in PATH; Japanese IME unavailable"
        echo "  build/install: (cd apps/whiz && make im-wayland install-wayland)"
    fi
fi

# Clipboard manager: keeps seat selection alive after the copying app exits.
# Always use system libwayland (like whiz-im) — LD_PRELOAD of the vendored
# client broke offer receive (roundtrip/FD) so history stayed empty.
# Opt out with LUNA_CLIPBOARD=none.
CLIPBOARD="${LUNA_CLIPBOARD:-luna-clipboard}"
if [ "$CLIPBOARD" != "none" ] && [ "$CLIPBOARD" != "0" ]; then
    if command -v "$CLIPBOARD" >/dev/null 2>&1; then
        echo "→ Starting clipboard manager ($CLIPBOARD)"
        env -u LD_PRELOAD -u LUNA_WAYLAND_CLIENT_PRELOAD "$CLIPBOARD" -v &
        CLIPBOARD_PID=$!
        sleep 0.1
        if ! kill -0 "$CLIPBOARD_PID" 2>/dev/null; then
            echo "warning: clipboard manager exited immediately; continuing without it"
            wait "$CLIPBOARD_PID" || true
            CLIPBOARD_PID=""
        fi
    elif [ -n "${LUNA_CLIPBOARD:-}" ]; then
        echo "warning: LUNA_CLIPBOARD not found: $CLIPBOARD"
    fi
fi

if [ -n "${LUNA_APPS:-}" ]; then
    for app in $LUNA_APPS; do
        echo "→ Launching app: $app"
        if [ "$USE_SYSTEM_WAYLAND" = "1" ]; then
            env -u LD_PRELOAD $app &
        else
            LD_LIBRARY_PATH="${LUNA_WAYLAND_CLIENT_LIBPATH:-$LIB}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            LD_PRELOAD="$VENDORED_CLIENT" \
                $app &
        fi
        APP_PIDS+=($!)
    done
fi

if [ "$BACKEND" = "webgl" ]; then
    echo ""
    echo "  WebGL view → http://localhost:${PORT:-8081}/"
    echo ""
fi

# Supervise both core processes.  If either one exits, the EXIT trap stops the
# other and lets the compositor's graceful signal path restore the console.
set +e
wait -n "$SHELL_PID" "$COMPOSITOR_PID"
SESSION_STATUS=$?
set -e
if ! kill -0 "$SHELL_PID" 2>/dev/null; then
    echo "→ Luna shell exited (status=$SESSION_STATUS); stopping session"
else
    echo "→ Luna compositor exited (status=$SESSION_STATUS); stopping session"
fi
exit "$SESSION_STATUS"
